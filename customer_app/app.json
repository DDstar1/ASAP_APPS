{
  "expo": {
    "name": "Asap Customer",
    "slug": "asap_customer",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9b36bbb6-031c-495a-b243-18fec9699b28"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "asapcustomer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ddhaven.asapcustomer",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ddhaven.asap_customer"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to take photos of the package you are sending, so your rider can identify it at pickup.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can choose a profile picture and send package photos in chat.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to take photos of the package you are sending, so your rider can identify it at pickup.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to set your pickup point, find nearby riders and share your location with your rider."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-asap.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1F2124"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#FF7518"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "slamanii",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b36bbb6-031c-495a-b243-18fec9699b28"
      }
    }
  }
}
