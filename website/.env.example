# Copy to .env.local (or set in the host's env). The NEXT_PUBLIC_ ones are
# public browser values: never put service_role or the Korapay secret here.

# SERVER ONLY (no NEXT_PUBLIC_ prefix, never sent to the browser).
# Zazu billing on Paystack, used by app/api/billing/* only.
PAYSTACK_SECRET_KEY=
# Same value as the Vault secret 'billing_server_secret'
BILLING_SERVER_SECRET=

# Supabase project (same as the apps' SUPABASE_URL / SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Rust API (same as the apps' RUST_API_URL); the payout bank list comes from it
NEXT_PUBLIC_RUST_API_URL=

# Store-location picker on vendor signup and Settings (Maps JS + Places API (New))
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyB3Pkakn3m13pT0UH_zy62u9KNJJXPcWL8

# App Store links need the numeric Apple ID; their buttons stay hidden until set
NEXT_PUBLIC_RIDER_APP_STORE_URL=
NEXT_PUBLIC_CUSTOMER_APP_STORE_URL=
NEXT_PUBLIC_CUSTOMER_APPLE_APP_ID=

# Where the homepage "Zazu" button goes; it shows but goes nowhere until set
NEXT_PUBLIC_ZAZU_URL=
