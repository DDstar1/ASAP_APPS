{
  "expo": {
    "name": "Asap Rider",
    "slug": "asap_rider",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/af769a3a-927e-4b7f-9ce2-3b6af16cc50b"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "asaprider",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ddhaven.asaprider",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.ddhaven.asap_rider"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to photograph packages at pickup and delivery as proof of handover.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can choose a profile picture and send package photos in chat.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to photograph packages at pickup and delivery as proof of handover.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to show nearby delivery requests and guide you to pickup and drop-off points.",
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location in the background during an active delivery, so the customer can track their package in real time. Tracking stops when the delivery ends.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-asap.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1F2124"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF7518"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "slamanii",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af769a3a-927e-4b7f-9ce2-3b6af16cc50b"
      }
    }
  }
}
